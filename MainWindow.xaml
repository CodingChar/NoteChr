<Window x:Class="NoteChr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NoteChr" Height="700" Width="1000"
        MinHeight="400" MinWidth="600"
        FontFamily="{DynamicResource AppFont}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="MainWindow_Closing"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Toolbar button style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aplica el tema también a los submenús, que no heredan el estilo con clave. -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>

        <!-- Close tab button style -->
        <Style x:Key="CloseTabButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu x:Name="MainMenu" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Menu.Resources>
                <Style TargetType="Separator" BasedOn="{StaticResource MenuSeparator}"/>
            </Menu.Resources>
            <MenuItem Header="Archivo" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="Nuevo" InputGestureText="Ctrl+N" Click="NewFile_Click"/>
                <MenuItem Header="Abrir..." InputGestureText="Ctrl+O" Click="OpenFile_Click"/>
                <MenuItem Header="Abrir carpeta..." Click="OpenFolder_Click"/>
                <MenuItem Header="Guardar" InputGestureText="Ctrl+S" Click="SaveFile_Click"/>
                <MenuItem Header="Guardar como..." InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="Cerrar pestaña" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <Separator/>
                <MenuItem Header="Salir" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Edición" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="Deshacer" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                <MenuItem Header="Rehacer" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                <Separator/>
                <MenuItem Header="Cortar" InputGestureText="Ctrl+X" Click="Cut_Click"/>
                <MenuItem Header="Copiar" InputGestureText="Ctrl+C" Click="Copy_Click"/>
                <MenuItem Header="Pegar" InputGestureText="Ctrl+V" Click="Paste_Click"/>
                <MenuItem Header="Seleccionar todo" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <Separator/>
                <MenuItem Header="Buscar..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                <MenuItem Header="Reemplazar..." InputGestureText="Ctrl+H" Click="ReplaceMenu_Click"/>
            </MenuItem>
            <MenuItem Header="Ver" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="Pestaña siguiente" InputGestureText="Ctrl+Tab" Click="NextTab_Click"/>
                <MenuItem Header="Pestaña anterior" InputGestureText="Ctrl+Shift+Tab" Click="PrevTab_Click"/>
                <Separator/>
                <MenuItem Header="Zoom +" InputGestureText="Ctrl++" Click="ZoomIn_Click"/>
                <MenuItem Header="Zoom -" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                <MenuItem Header="Restablecer zoom" InputGestureText="Ctrl+0" Click="ZoomReset_Click"/>
                <Separator/>
                <MenuItem x:Name="ThemeMenu" Header="Tema"/>
            </MenuItem>
            <MenuItem Header="Ayuda" Style="{DynamicResource ModernMenuItem}">
                <MenuItem Header="Atajos de teclado" InputGestureText="F1" Click="Help_Click"/>
                <MenuItem Header="Acerca de" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray x:Name="MainToolbar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" IsLocked="True">
            <ToolBar Background="Transparent" Band="0" BandIndex="0">
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Nuevo (Ctrl+N)" Click="NewFile_Click">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Abrir (Ctrl+O)" Click="OpenFile_Click">
                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Guardar (Ctrl+S)" Click="SaveFile_Click">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Cortar (Ctrl+X)" Click="Cut_Click">
                    <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Copiar (Ctrl+C)" Click="Copy_Click">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Pegar (Ctrl+V)" Click="Paste_Click">
                    <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Buscar (Ctrl+F)" Click="Find_Click">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Style="{DynamicResource ToolbarButton}" ToolTip="Mostrar/ocultar explorador (Ctrl+B)" Click="ToggleExplorer_Click">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Área principal: explorador de archivos + editor -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerBorder" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="EXPLORADOR" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="＋" ToolTip="Abrir carpeta" Style="{DynamicResource ToolbarButton}"
                                        Padding="5,1" Click="OpenFolder_Click"/>
                                <Button Content="↻" ToolTip="Actualizar" Style="{DynamicResource ToolbarButton}"
                                        Padding="5,1" Click="RefreshExplorer_Click"/>
                                <Button Content="◀" ToolTip="Ocultar explorador (Ctrl+B)" Style="{DynamicResource ToolbarButton}"
                                        Padding="5,1" Click="ToggleExplorer_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ExplorerRootText" DockPanel.Dock="Top" Text="Sin carpeta abierta"
                                TextTrimming="CharacterEllipsis" Padding="8,3" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TreeView x:Name="ExplorerTree" BorderThickness="0" Background="Transparent"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              SelectedItemChanged="ExplorerTree_SelectedItemChanged"
                              MouseDoubleClick="ExplorerTree_MouseDoubleClick"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right"
                          Background="Transparent" ShowsPreview="True"
                          Cursor="SizeWE" DragCompleted="ExplorerSplitter_DragCompleted"/>

            <!-- Tab Control: las pestañas se crean en código (MainWindow.AddTab) -->
        <TabControl x:Name="MainTabControl" Grid.Column="1" Margin="0" Padding="0"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderThickness="0"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItem}"/>
            </TabControl.Resources>
        </TabControl>
        </Grid>

        <!-- Status Bar -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="3" Background="{DynamicResource StatusBarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Listo" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PositionText" Text="Ln 1, Col 1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="EncodingText" Text="UTF-8" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ZoomText" Text="100%" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Find/Replace Panel (hidden by default) -->
        <Border x:Name="FindPanel" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="8" Padding="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Visibility="Collapsed" Panel.ZIndex="100">
            <Border.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="SelectionBrush" Value="{DynamicResource CompletionSelectedBrush}"/>
                </Style>
            </Border.Resources>
            <StackPanel>
                <TextBlock Text="Buscar:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="FindTextBox" Width="200" FontSize="13" Padding="3" Margin="0,0,0,5"/>
                <TextBlock Text="Reemplazar:" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ReplaceTextBox" Width="200" FontSize="13" Padding="3" Margin="0,0,0,5"/>
                <TextBlock Text="Enter busca · Mayús+Enter reemplaza · Esc cierra"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Buscar" Style="{DynamicResource ToolbarButton}" Click="FindNext_Click" Margin="0,0,4,0"/>
                    <Button Content="Reemplazar" Style="{DynamicResource ToolbarButton}" Click="Replace_Click" Margin="0,0,4,0"/>
                    <Button Content="Reemplazar todo" Style="{DynamicResource ToolbarButton}" Click="ReplaceAll_Click" Margin="0,0,4,0"/>
                    <Button Content="Cerrar" Style="{DynamicResource ToolbarButton}" Click="CloseFind_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
